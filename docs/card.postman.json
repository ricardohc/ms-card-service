  "item": [
    {
      "name": "01 - Listar tarjetas → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('CardPage válido', () => {",
              "  pm.expect(j).to.have.property('content');",
              "  pm.expect(j.content).to.be.an('array');",
              "  pm.expect(j).to.have.property('page');",
              "  pm.expect(j).to.have.property('size');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-ID", "value": "{{$guid}}" },
          { "key": "X-Channel-ID", "value": "{{channelId}}" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cards?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cards"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "02 - Crear tarjeta CRÉDITO válida → 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('CardResponse CREDIT', () => {",
              "  pm.expect(j).to.have.property('id');",
              "  pm.expect(j.type).to.eql('CREDIT');",
              "  pm.expect(j.status).to.eql('ACTIVE');",
              "  pm.expect(j).to.have.property('maskedPan');",
              "});",
              "pm.collectionVariables.set('creditCardId', j.id);",
              "pm.collectionVariables.set('creditLimit', j.creditLimit);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" },
          { "key": "X-Channel-ID", "value": "{{channelId}}" },
          { "key": "X-Transaction-ID", "value": "{{$guid}}" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"type\": \"CREDIT\",\n  \"creditLimit\": \"5000.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cards",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cards"]
        }
      }
    },
